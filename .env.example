# Local environment example for Tailor On The Road

# =============================
# Database
# =============================
DATABASE_URL="postgresql://user:password@localhost:5432/totr"

# =============================
# Next.js/Shopify Storefront
# =============================
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-shop-name"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="storefront-access-token"
NEXT_PUBLIC_SHOPIFY_API_VERSION="2024-10"

# =============================
# Shopify Admin (server-side only)
# =============================
SHOPIFY_STORE_DOMAIN="your-shop-name"
SHOPIFY_ADMIN_API_TOKEN="admin-api-access-token"
SHOPIFY_API_VERSION="2024-10"

# =============================
# Shopify Customer Account OAuth (headless)
# =============================
# Optional APP_BASE_URL override for callback construction
# APP_BASE_URL="https://your-preview-or-production-domain"

# OAuth authorize endpoint from your Shopify Customer Account app setup
SHOPIFY_CUSTOMER_ACCOUNT_AUTHORIZE_URL=""

# OAuth token exchange endpoint
SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_URL=""

# Client ID for Customer Account OAuth app
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=""

# Client secret if required by your app type
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=""

# Optional explicit redirect URI (otherwise uses APP_BASE_URL + /api/auth/customer-account/callback)
# SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=""

# Customer Account GraphQL endpoint for profile lookup with customer-scoped token
# SHOPIFY_CUSTOMER_ACCOUNT_API_URL=""

# Optional scopes (default: "openid email")
# SHOPIFY_CUSTOMER_ACCOUNT_SCOPES="openid email"

# =============================
# Other services
# =============================
# KLAVIYO_API_KEY=""
# STRIPE_SECRET_KEY=""
# REDIS_URL="redis://localhost:6379"
