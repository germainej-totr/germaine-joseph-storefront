{
  "name": "my-shopify-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "This is a [Next.js](https://nextjs.org) project bootstrapped with [`create-next-app`](https://nextjs.org/docs/app/api-reference/cli/create-next-app).",
  "main": "server.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:metafield-boolean": "ts-node --esm scripts/test-metafield-boolean.ts",
    "test:home-product-card-flow": "ts-node --esm scripts/test-home-product-card-flow.ts",
    "test:booking-calendar-utils": "ts-node --esm scripts/test-booking-calendar-utils.ts",
    "test:api-contracts": "ts-node --esm scripts/test-api-contracts.ts",
    "test:routing-contract": "ts-node --esm scripts/test-routing-contract.ts",
    "test:contracts": "npm run test:api-contracts && npm run test:routing-contract && npm run test:home-product-card-flow && npm run test:booking-calendar-utils",
    "qa:product-api-runtime": "ts-node --esm scripts/qa-product-api-contracts.ts",
    "qa:prisma-connectivity": "node scripts/qa-prisma-connectivity.mjs",
    "db:migrate:safe": "node scripts/db-migrate-safe.mjs",
    "db:migrate:doctor": "node scripts/db-migrate-doctor.mjs",
    "qa:predeploy": "npm run qa:prisma-connectivity && npm run test:contracts && npm run lint && npm run build",
    "qa:runtime-smoke": "node scripts/runtime-smoke.mjs",
    "qa:mtm-ui-checklist": "node scripts/posthog/mtm-ui-path-qa.mjs checklist",
    "qa:mtm-ui-init-report": "node scripts/posthog/mtm-ui-path-qa.mjs init-report",
    "verify:analytics": "node scripts/verifyAnalyticsPipeline.mjs",
    "seed:posthog-dashboards": "node scripts/seedPostHogDashboard.mjs",
    "repair:posthog-non-tailor-funnel": "node scripts/repairPostHogNonTailorFunnel.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "framer-motion": "^12.26.2",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.3",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.27",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^6.19.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
