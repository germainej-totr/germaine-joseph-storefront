datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- 1. Customer: Unified Identity ---
model Customer {
  id          String       @id @default(uuid())
  shopifyId   String       @unique
  email       String       @unique
  fitProfiles FitProfile[]
  createdAt   DateTime     @default(now())
}

// --- 2. Fit Profiles: The master identity of the client ---
model FitProfile {
  id              String           @id @default(cuid())
  email           String           @unique
  profile_name    String?
  jacketSize      String?
  trouserSize     String?
  fitPreference   String?
  appointmentDate String?
  appointmentTime String?
  technicalSpecs  Json?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  measurements    FitMeasurement[]
  bookings        Booking[]
  specs           ProductionSpec[]
  fittingSessions FittingSession[]
}

// --- 3. Fitting Sessions: The Unified Tailors Dashboard Data ---
model FittingSession {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  shopifyOrderId   String        @unique
  productionLine   String
  jacketBaseBlock  String?
  trouserBaseBlock String?
  masterFitType    String?
  measurements     Json
  tailorName       String?
  customerEmail    String
  status           FittingStatus @default(DRAFT)
  
  // Relation back to FitProfile
  fitProfileId     String?
  fitProfile       FitProfile?   @relation(fields: [fitProfileId], references: [id])

  @@map("fitting_sessions")
}

enum FittingStatus {
  DRAFT
  ORDERED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
}

// --- 4. Fit Measurements: Versioned anatomical data ---
model FitMeasurement {
  id           String     @id @default(uuid())
  fitProfileId String
  fitProfile   FitProfile @relation(fields: [fitProfileId], references: [id], onDelete: Cascade)
  category     String
  data         Json
  source       String?
  confidence   Int        @default(0)
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
}

// --- 5. Design Sessions: In-progress suit designs ---
model DesignSession {
  id         String   @id @default(uuid())
  user_email String?
  productId  String
  selections Json
  updatedAt  DateTime @updatedAt
}

// --- 6. Bookings & Logistics ---
model Booking {
  id               String      @id @default(uuid())
  email            String
  serviceType      String
  startAt          DateTime
  location         Json
  status           String      @default("confirmed")
  depositStatus    String      @default("none")
  fitProfileId     String?
  fitProfile       FitProfile? @relation(fields: [fitProfileId], references: [id])
  notes            String?
  suggestedJacket  String?
  suggestedTrouser String?
  tailorNotes      String?
  createdAt        DateTime    @default(now())
}

// --- 7. Production Specs: Technical handover to workshop ---
model ProductionSpec {
  id           String     @id @default(uuid())
  orderId      String
  fitProfileId String
  fitProfile   FitProfile @relation(fields: [fitProfileId], references: [id])
  spec         Json
  status       String     @default("queued")
  createdAt    DateTime   @default(now())
}

// --- 8. Fabric Catalogue (A16) ---
model Fabric {
  id              String   @id @default(cuid())
  /// Human-readable fabric name, e.g. "Zegna Traveller Wool"
  name            String
  /// Short description for the browsing UI
  description     String?
  /// e.g. "Vitale Barberis Canonico", "Zegna", "Holland & Sherry"
  mill            String
  /// Season relevance: all_season | spring_summer | autumn_winter
  season          String
  /// Comma-separated composition, e.g. "100% Wool", "80% Wool, 20% Cashmere"
  composition     String
  /// Colour family bucket: navy | grey | charcoal | brown | beige | black | blue | green | other
  colourFamily    String
  /// Pattern type: plain | stripe | check | windowpane | herringbone | houndstooth | texture | other
  pattern         String
  /// Fabric weight in grams per linear metre (g/m)
  weightGm        Int?
  /// Internal mill/supplier article code
  articleCode     String?  @unique
  /// Cost price in pence / cents (store minor unit to avoid floats)
  costPricePence  Int?
  /// Retail upcharge added on top of garment base price, in pence
  upchargePence   Int      @default(0)
  /// URL to swatch image
  swatchImageUrl  String?
  /// URL to close-up drape image
  drapeImageUrl   String?
  /// Comma-separated garment categories this fabric is suitable for, e.g. "trouser,jacket"
  suitableFor     String
  /// e.g. "Dry clean only", "Machine wash 30"
  careInstructions String?
  /// Whether visible in the storefront selector
  isActive        Boolean  @default(true)
  /// Exclusive / limited allocation flag
  isLimitedEdition Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([colourFamily])
  @@index([pattern])
  @@index([season])
  @@index([mill])
  @@index([isActive])
  @@map("fabrics")
}